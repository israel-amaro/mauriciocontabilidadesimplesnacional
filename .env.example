# Sem variáveis, o portal usa apresentação no navegador.
PORTAL_MODE=presentation
# Configuração opcional do backend: mude PORTAL_MODE para production.
ADMIN_EMAIL=admin@mauriciorocha.local
# Gere as credenciais com npm run setup. Nunca use a senha em texto puro aqui.
ADMIN_PASSWORD_HASH=
EMPLOYEE_EMAIL=
EMPLOYEE_PASSWORD_HASH=
CLIENT_EMAIL=
CLIENT_PASSWORD_HASH=
# ID do registro que este cliente pode visualizar; definido somente pelo servidor.
CLIENT_LEAD_ID=
AUTH_SECRET=
LOCAL_DATABASE=true
DEMO_ENABLED=true
APP_URL=http://127.0.0.1:3000
# Obrigatório apenas no modo production hospedado na Vercel.
DATABASE_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v25.0
